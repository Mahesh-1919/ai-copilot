{
  "name": "adshield-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Desktop interview copilot with screen-share invisibility",
  "license": "MIT",
  "author": "",
  "keywords": [
    "interview",
    "copilot",
    "electron"
  ],
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "dist": "npm run check && node scripts/build.mjs --release && electron-builder --win --x64",
    "dist:portable": "npm run check && node scripts/build.mjs --release && electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.adshield.desktop",
    "productName": "System Monitor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": ".",
        "filter": [
          "api-keys.json",
          "resume.{txt,md}",
          "job-description.{txt,md}",
          "jd.{txt,md}"
        ]
      },
      {
        "from": "..",
        "to": ".",
        "filter": [
          "api-keys.json",
          "resume.{txt,md}",
          "job-description.{txt,md}",
          "jd.{txt,md}"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "sign": false
    },
    "electronDownload": {
      "mirror": "https://github.com/electron/electron/releases/download/"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
